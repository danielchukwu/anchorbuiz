{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./convex/**/*.ts", "./hooks/**/*.ts", "./lib/**/*.ts", "./src/**/*.ts", "./types/**/*.ts"],
  "exclude": ["./convex/_generated"]
}

{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./styles/*": "./src/styles/*",
    "./fonts/*": "./src/fonts/*",
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*.ts",
      "./src/components/*"
    ],
    "./icons": "./src/icons/index.ts",
    "./icons/*": [
      "./src/icons/*.tsx",
      "./src/icons/*.ts",
      "./src/icons/*"
    ],
    "./hooks/useMobile": "./src/hooks/useMobile.ts",
    "./hooks/*": [
      "./src/hooks/*.tsx",
      "./src/hooks/*.ts",
      "./src/hooks/*"
    ],
    "./lib/*": [
      "./src/lib/*.tsx",
      "./src/lib/*.ts",
      "./src/lib/*"
    ],
    "./*": [
      "./src/*.tsx",
      "./src/*.ts",
      "./src/*"
    ]
  },
  "typesVersions": {
    "*": {
      "styles/*": [
        "./src/styles/*"
      ],
      "fonts/*": [
        "./src/fonts/*"
      ],
      "components/*": [
        "./src/components/*.tsx",
        "./src/components/*.ts",
        "./src/components/*"
      ],
      "icons": [
        "./src/icons/index.ts"
      ],
      "icons/*": [
        "./src/icons/*.tsx",
        "./src/icons/*.ts",
        "./src/icons/*"
      ],
      "hooks/useMobile": [
        "./src/hooks/useMobile.ts"
      ],
      "hooks/*": [
        "./src/hooks/*.tsx",
        "./src/hooks/*.ts",
        "./src/hooks/*"
      ],
      "lib/*": [
        "./src/lib/*.tsx",
        "./src/lib/*.ts",
        "./src/lib/*"
      ],
      "*": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ]
    }
  },
  "scripts": {
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "usehooks-ts": "^3.1.0",
    "vaul": "^1.1.2"
  }
}
